{
  "name": "coach-arena-5k",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:stack:start": "node scripts/test-stack.mjs start",
    "test:stack:stop": "node scripts/test-stack.mjs stop",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=desktop --project=mobile tests/e2e/public.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.114.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.25.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "0.36.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
